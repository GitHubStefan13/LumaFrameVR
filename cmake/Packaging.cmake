# Packaging target.
#
# The version is never hardcoded here: it comes from the project() version in
# the top level CMakeLists.txt, so bumping the release is a one line change.
#
# Packaging produces a release, so the target only exists in a Release build:
#
#   cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
#   cmake --build build --target installer
#
# One target runs the whole chain: it assembles the flat payload, packs the
# release archive, and builds the self-extracting installer plus the directory
# bundle, all under build/dist. The steps are the CMake modules in cmake/ and
# the tooling in scripts/; this target supplies the version and the paths.

set(LUMAFRAMEVR_VERSION "${PROJECT_VERSION}")
set(LUMAFRAMEVR_RELEASE_NAME "lumaframevr-steam-frame-arm64-${LUMAFRAMEVR_VERSION}")
set(LUMAFRAMEVR_DIST_DIR "${CMAKE_BINARY_DIR}/dist")
set(LUMAFRAMEVR_PAYLOAD_DIR "${CMAKE_BINARY_DIR}/payload")
set(LUMAFRAMEVR_INSTALLER_BUILD "1" CACHE STRING "Installer build number")
set(LUMAFRAMEVR_RELEASE_URL "https://github.com/GitHubStefan13/LumaFrameVR/releases/download/${PROJECT_VERSION}" CACHE STRING "HTTPS release asset directory")
set(LUMAFRAMEVR_RELEASE_NOTES "" CACHE STRING "Update manifest release notes")
# The audit is generated by the installer chain itself, into the build tree, so it always
# describes the binary that is being packaged. Point the cache variable elsewhere to keep it.
if(NOT LUMAFRAMEVR_LIBS_AUDIT)
  set(LUMAFRAMEVR_LIBS_AUDIT "${LUMAFRAMEVR_DIST_DIR}/linked-libraries.json")
endif()
# The payload ships no FFmpeg. The player links libavcodec, libavformat, libavutil and
# libswresample from the AArch64 SDK at build time and finds them on the frame at runtime,
# because they are the frame's own libraries. There is no local decoder build to point at
# and nothing to copy into the payload, so assembly has no FFmpeg inputs.
set(LUMAFRAMEVR_LIBS_AUDIT "" CACHE FILEPATH
  "Where to write the library audit; empty means build/dist/linked-libraries.json")
set(LUMAFRAMEVR_RUNTIME_DIR "" CACHE PATH
  "Optional directory of libraries to ship in runtime/ (the OpenVR API library; the OpenXR and
      Vulkan loaders are deliberately left to the system)")
option(LUMAFRAMEVR_ALLOW_HOST_ARCHITECTURE
  "Package a non-AArch64 player (x86_64 development host); off by default because a release targets the Steam Frame"
  OFF)

if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  message(STATUS "The 'installer' target is only available in a Release build")
  return()
endif()

find_package(Python3 REQUIRED COMPONENTS Interpreter)

# A release targets the Steam Frame, so AArch64 is the default and the scripts
# enforce it. Only an explicit -DLUMAFRAMEVR_ALLOW_HOST_ARCHITECTURE=ON relaxes
# that, for packaging on an x86_64 development host.
set(LUMAFRAMEVR_HOST_ARCH_FLAG "")
if(LUMAFRAMEVR_ALLOW_HOST_ARCHITECTURE)
  set(LUMAFRAMEVR_HOST_ARCH_FLAG --allow-host-architecture)
endif()

if(TARGET lumaframevr)
  add_custom_target(installer
    # 0. Clear the previous run. build/dist is a build directory, not a published
    #    location, so the target is repeatable; the packaging step still refuses
    #    to overwrite a published release outside the build tree.
    COMMAND "${CMAKE_COMMAND}" -E rm -rf "${LUMAFRAMEVR_DIST_DIR}"
    # 0b. Audit the libraries the player links. Generated here, from the binary that is
    #     about to be packaged, so the audit can never describe a different build.
    COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_SOURCE_DIR}/scripts/library-audit.py"
      --binary $<TARGET_FILE:lumaframevr>
      --output "${LUMAFRAMEVR_LIBS_AUDIT}"
    # 1. Assemble the flat payload the packaging step consumes.
    COMMAND "${CMAKE_COMMAND}"
      -DPAYLOAD_DIR=${LUMAFRAMEVR_PAYLOAD_DIR}
      -DBINARY=$<TARGET_FILE:lumaframevr>
      -DSOURCE_DIR=${CMAKE_SOURCE_DIR}
      -DSHADER_DIR=${LUMAFRAMEVR_SHADER_DIRECTORY}
      -DVERSION=${LUMAFRAMEVR_VERSION}
      -DBUILD_TYPE=Release
      -DRUNTIME_DIR=${LUMAFRAMEVR_RUNTIME_DIR}
      -DLIBS_AUDIT=${LUMAFRAMEVR_LIBS_AUDIT}
      -P "${CMAKE_SOURCE_DIR}/cmake/AssemblePayload.cmake"
    # 2. Pack the release archive (.tar.gz + .sha256).
    COMMAND "${CMAKE_COMMAND}"
      -DPAYLOAD_DIR=${LUMAFRAMEVR_PAYLOAD_DIR}
      -DCANDIDATE=${LUMAFRAMEVR_VERSION}
      -DOUTPUT_DIR=${LUMAFRAMEVR_DIST_DIR}
      -DSOURCE_DIR=${CMAKE_SOURCE_DIR}
      -DALLOW_HOST_ARCHITECTURE=${LUMAFRAMEVR_ALLOW_HOST_ARCHITECTURE}
      -P "${CMAKE_SOURCE_DIR}/cmake/PackageRelease.cmake"
    # 3. Build the self-extracting installer and the directory bundle.
    COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_SOURCE_DIR}/scripts/build-installer.py"
      --version "${LUMAFRAMEVR_VERSION}"
      --build "${LUMAFRAMEVR_INSTALLER_BUILD}"
      --payload "${LUMAFRAMEVR_DIST_DIR}/${LUMAFRAMEVR_RELEASE_NAME}.tar.gz"
      --output "${LUMAFRAMEVR_DIST_DIR}/lumaframevr-desktop-installer-${LUMAFRAMEVR_VERSION}-${LUMAFRAMEVR_INSTALLER_BUILD}.run"
      --directory "${LUMAFRAMEVR_DIST_DIR}/lumaframevr-installer-${LUMAFRAMEVR_VERSION}"
      ${LUMAFRAMEVR_HOST_ARCH_FLAG}
    COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_SOURCE_DIR}/scripts/update-manifest.py"
      --payload "${LUMAFRAMEVR_DIST_DIR}/${LUMAFRAMEVR_RELEASE_NAME}"
      --installer "${LUMAFRAMEVR_DIST_DIR}/lumaframevr-desktop-installer-${LUMAFRAMEVR_VERSION}-${LUMAFRAMEVR_INSTALLER_BUILD}.run"
      --version "${LUMAFRAMEVR_VERSION}"
      --release-url "${LUMAFRAMEVR_RELEASE_URL}"
      --notes "${LUMAFRAMEVR_RELEASE_NOTES}"
      --output "${LUMAFRAMEVR_DIST_DIR}/latest.json"
    DEPENDS lumaframevr
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    COMMENT "Building installer ${LUMAFRAMEVR_VERSION}-${LUMAFRAMEVR_INSTALLER_BUILD}"
    VERBATIM)

  # `package` is the conventional CMake name for the same chain, so either
  # target works: `cmake --build build --target package` or `--target installer`.
  add_custom_target(package DEPENDS installer)
endif()
